## DERMA AI — Environment Variables
## Copy this file to .env and fill in your credentials
## ⚠️  Never commit your real .env to version control

# ── Supabase (required for auth, appointments, edge function booking) ─────
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Edge function URL: {VITE_SUPABASE_URL}/functions/v1/book-appointment

# Bootstrap admin (dev / first-time setup — login tab "Admin")
VITE_BOOTSTRAP_ADMIN_EMAIL=admin@dermaai.com
VITE_BOOTSTRAP_ADMIN_PASSWORD=DermaAdmin@2026
VITE_ENABLE_BOOTSTRAP_ADMIN=true
# Optional: for npm run seed:admin (never commit service role)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Firebase — Firestore for scans & doctor profiles ────────────────────────
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── HuggingFace FastAPI Backend (optional — app uses mock AI without this) ──
VITE_HF_API_URL=https://YOUR_USERNAME-derma-ai-api.hf.space

# ── App info ─────────────────────────────────────────────────────────────────
VITE_APP_NAME=DERMA AI
VITE_APP_VERSION=1.0.0

# ═══════════════════════════════════════════════════════════════════════════════
# SERVER-SIDE ONLY — Set these in Vercel Dashboard → Settings → Environment Variables
# Do NOT prefix with VITE_ — these must never be exposed to the browser
# ═══════════════════════════════════════════════════════════════════════════════

# ── Resend Email API (https://resend.com/api-keys) ───────────────────────────
# Free tier: 3,000 emails/month. Create account → verify domain → get API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Email sender address ─────────────────────────────────────────────────────
# For testing: use "onboarding@resend.dev" (Resend sandbox, sends to verified emails only)
# For production: use your verified domain, e.g. "DERMA AI <noreply@yourdomain.com>"
EMAIL_FROM=DERMA AI <onboarding@resend.dev>

# ── Google Calendar API — for real Google Meet link generation ───────────────
# Step 1: console.cloud.google.com → New Project → Enable "Google Calendar API"
# Step 2: IAM → Service Accounts → Create → Download JSON key
# Step 3: Share a Google Calendar with the service account email
#         (Calendar Settings → Share → grant "Make changes to events")
# Local dev: save JSON as secrets/google-service-account.json (gitignored)
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=secrets/google-service-account.json
# Vercel production: paste full JSON as one line OR use the path above in build
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── Google Calendar ID ───────────────────────────────────────────────────────
# "primary" only works if you have Google Workspace with domain-wide delegation.
# For personal Gmail: Go to calendar.google.com → Settings → calendar ID looks like
# "xxxxxxxxxxxxxxxxxxxxxxxx@group.calendar.google.com" — paste it below.
GOOGLE_CALENDAR_ID=primary

# ── Twilio WhatsApp (optional — for server-side WhatsApp messages) ───────────
# Get credentials from: console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
